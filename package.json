{
  "name": "kodra-agent-monorepo",
  "private": true,
  "description": "Kodra AI Agent: a self-hosted, customizable AI DevOps agent",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kodra-agent/configurator dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:export": "pnpm --filter @kodra-agent/connectors schema:export",
    "test:e2e": "pnpm --filter @kodra-agent/configurator test:e2e",
    "mcp:fetch": "pnpm --filter @kodra-agent/agent mcp:fetch",
    "test:kind": "pnpm --filter @kodra-agent/agent test:kind"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
