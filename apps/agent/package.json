{
  "name": "@kodra-agent/agent",
  "version": "0.3.13",
  "private": true,
  "description": "Kodra AI Agent runtime and CLI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kodra-agent": "./src/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/bin.ts",
    "mcp:fetch": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fetch-mcp.ts",
    "test:kind": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/kind-test.ts",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/eval.ts",
    "test:package": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/package-test.ts",
    "test:proxy": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/proxy-test.ts",
    "demo:slack": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/kind-test.ts --demo-slack"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.104",
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/azure": "4.0.89",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@aws-sdk/client-sts": "3.1146.0",
    "@aws-sdk/credential-providers": "3.1144.0",
    "@inquirer/password": "5.2.2",
    "@kodra-agent/connectors": "workspace:*",
    "@kodra-agent/schema": "workspace:*",
    "@kodra-agent/templates": "workspace:*",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@slack/bolt": "5.1.0",
    "@smithy/signature-v4": "5.7.4",
    "ai": "7.0.126",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "ssh2": "1.17.0",
    "undici": "8.12.2",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ssh2": "1.15.6"
  }
}
